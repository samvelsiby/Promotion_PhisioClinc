            },
            {
              "_type": "link",
              "_key": "link2",
              "href": "https://www.promotionphysiotherapy.ca/blogs/shoulder-pain-reaching-overhead-winnipeg"
            }
          ],
          "children": [
            {
              "_type": "span",
              "_key": "s0",
              "text": "Read about our ",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "s1",
              "text": "shoulder physiotherapy service",
              "marks": [
                "link0"
              ]
            },
            {
              "_type": "span",
              "_key": "s2",
              "text": ", or ",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "s3",
              "text": "book an appointment",
              "marks": [
                "link1"
              ]
            },
            {
              "_type": "span",
              "_key": "s4",
              "text": ". If reaching overhead is your main concern, our ",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "s5",
              "text": "overhead shoulder pain guide",
              "marks": [
                "link2"
              ]
            },
            {
              "_type": "span",
              "_key": "s6",
              "text": " covers what to discuss at an assessment.",
              "marks": []
            }
          ]
        }
      ]
